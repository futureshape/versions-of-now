# Copy this file to sd-card.env and edit it locally.
# sd-card.env is gitignored because it can contain Wi-Fi and login secrets.

# Path to Raspberry Pi Imager. Leave empty to auto-detect common installs.
# macOS default:
# RPI_IMAGER="/Applications/Raspberry Pi Imager.app/Contents/MacOS/rpi-imager"
RPI_IMAGER=""

# GUI builds of Raspberry Pi Imager need --cli. Set this to "" only if you are
# using a CLI-only build that does not accept --cli.
RPI_IMAGER_CLI_FLAG="--cli"

# Raspberry Pi OS Lite 64-bit image. Use a local .img/.img.xz path or a URL.
# Raspberry Pi Imager can write URLs directly.
RPI_IMAGE="https://downloads.raspberrypi.com/raspios_lite_arm64_latest"

# Optional SHA-256 expected by Raspberry Pi Imager.
RPI_IMAGE_SHA256=""

# Keep enabled so the card is cleanly ejected or synced after userconf.txt is written.
RPI_EJECT_AFTER_WRITE="1"

# First-boot host identity.
PI_HOSTNAME="xdaliclock"
PI_ADMIN_USER="clockadmin"
PI_ADMIN_PASSWORD="change-this-password"

# Optional precomputed SHA-512 crypt hash for userconf.txt. Leave empty to have
# image-sd-card.sh generate one from PI_ADMIN_PASSWORD with openssl.
PI_ADMIN_PASSWORD_HASH=""

# Optional SSH public key file. Leave empty to rely on password SSH.
# Use an absolute path, especially if you run image-sd-card.sh with sudo.
SSH_AUTHORIZED_KEYS_FILE=""

# Wi-Fi settings. Leave SSID empty if using Ethernet only.
PI_WIFI_COUNTRY="GB"
PI_WIFI_SSID=""
PI_WIFI_PASSWORD=""
PI_WIFI_HIDDEN="0"

# Optional EMF event Wi-Fi fallback. These public event credentials are not
# intended to replace the private Wi-Fi values above; they add a second
# NetworkManager profile that can autoconnect when the Pi is on site.
PI_EMF_WIFI_ENABLE="1"
PI_EMF_WIFI_SSID="emf"
PI_EMF_WIFI_USERNAME="emf"
PI_EMF_WIFI_PASSWORD="emf"
PI_EMF_WIFI_EAP="ttls"
PI_EMF_WIFI_PHASE2_AUTH="mschapv2"

# Localisation.
PI_TIMEZONE="Europe/London"
PI_LOCALE="en_GB.UTF-8"

# Set to 1 to skip the destructive confirmation prompt.
YES_REALLY_WRITE="0"
